# ════════════════════════════════════════════════════════════════════════════════
# 🏛️ BOSKI LIMITED • ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env.local` and add your project-specific credentials.
#
# Obtain your Supabase keys from:
# https://supabase.com/dashboard/project/_/settings/api
# ════════════════════════════════════════════════════════════════════════════════

# 1. Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Key (Client-Safe / Public API key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 3. Supabase Service Role Key (Private / Server-Only API key)
# Required for server-side admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 4. JWT Secret for Admin Session Signing
JWT_SECRET=atelier_luxury_linens_master_key_2026

# 5. App URL (Default for development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
